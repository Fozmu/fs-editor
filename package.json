{
  "name": "fs-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:desktop": "node electron/dev.mjs",
    "start:desktop": "vite build && electron .",
    "dist:win": "tsc -b && vite build && electron-builder --win --x64",
    "dist:dir": "tsc -b && vite build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "immer": "^11.2.9",
    "mediabunny": "^1.62.0",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "zustand": "^5.0.16"
  },
  "productName": "F.S. Editor",
  "description": "F.S. Editor \u2014 video editor by Fozmu Studios",
  "author": {
    "name": "Fozmu Studios",
    "email": "fozmu.game@gmail.com"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.fozmu.fseditor",
    "productName": "F.S. Editor",
    "copyright": "\u00a9 Fozmu Studios",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "fileAssociations": [
      {
        "ext": "fsproj",
        "name": "F.S. Editor Project",
        "description": "F.S. Editor Project",
        "role": "Editor",
        "icon": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "FS-Editor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "F.S. Editor",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Fozmu",
        "repo": "fs-editor-releases",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://editor.fozmu.com"
}
